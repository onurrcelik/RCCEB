# ── Database: Aurora PostgreSQL writer endpoint ──────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@rcceb-db.cluster-XXXX.eu-central-1.rds.amazonaws.com:5432/rcceb

# ── File uploads: S3 bucket + an IAM user that can write to it ───────────────
AWS_REGION=eu-central-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Public URL of this portal (sign-in links, invite links, email links) ─────
APP_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# ── Admin access: comma-separated emails allowed into /admin ─────────────────
ADMIN_EMAILS=you@example.com

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=RCCEB <hello@rcceb.org>
EMAIL_REPLY_TO=hello@rcceb.org
# Comma-separated: who is notified about new applications and perk interest.
NOTIFICATION_EMAIL=you@example.com

# ── Secrets (generate each with: openssl rand -base64 32) ────────────────────
# Signs unsubscribe and "did you meet?" links.
APP_SECRET=
# Sent by the rcceb.org /api/join handler to POST /api/applications.
APPLICATIONS_INTAKE_SECRET=
# Optional: token for GET /api/health in production.
HEALTH_CHECK_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────
# TESSERACT_PATH=/opt/homebrew/bin/tesseract
# TESSERACT_LANGS=eng+tur
