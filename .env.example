# ── Supabase (auth, storage) ─────────────────────────────────────────────────
# Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role / secret key (server only — never expose to the browser).
SUPABASE_SECRET_KEY=

# ── Postgres ─────────────────────────────────────────────────────────────────
# Project settings → Database → Connection string (session pooler, port 5432).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Public URL of this portal ────────────────────────────────────────────────
# Used for magic-link redirects, invite links and email links.
APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=you@example.com

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=RCCEB <hello@rcceb.org>
EMAIL_REPLY_TO=hello@rcceb.org
# Comma-separated: who is notified about new applications and perk interest.
NOTIFICATION_EMAIL=you@example.com

# ── Integrations ─────────────────────────────────────────────────────────────
# Shared secret the rcceb.org /api/join handler sends to POST /api/applications.
APPLICATIONS_INTAKE_SECRET=
# Shared secret for the weekly 1-on-1 cron (GET /api/cron/weekly-match-round).
CRON_SECRET=
# Optional: separate key for signing unsubscribe links (defaults to SUPABASE_SECRET_KEY).
UNSUBSCRIBE_SECRET=
# Optional: token for GET /api/health in production.
HEALTH_CHECK_TOKEN=

# ── Optional overrides ───────────────────────────────────────────────────────
# STORAGE_BUCKET_AVATARS=avatars
# STORAGE_BUCKET_EVENTS=events
# TESSERACT_PATH=/opt/homebrew/bin/tesseract
# TESSERACT_LANGS=eng+tur
